# Microsoft SQL Server Database Configuration
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=HMC_CENTRAL_AUTOMATION
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPasswordHere!
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# API Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173

# Security & Cryptography
# 32-byte hexadecimal key for AES-256-GCM envelope encryption (Generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Account Security & Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Desktop Agent Configuration
AGENT_SHARED_SECRET=replace_with_agent_registration_secret_for_pairing
AGENT_HEARTBEAT_INTERVAL_MS=10000

# Retention Policies (Days)
RETENTION_SCREENSHOTS_DAYS=30
RETENTION_ERROR_LOGS_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=365
RETENTION_IMPORT_SUMMARIES_DAYS=365

# Local Fixture Server (Testing)
FIXTURE_SERVER_PORT=4000
FIXTURE_SERVER_URL=http://localhost:4000
